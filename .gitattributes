# Normalise line endings in the repository, check out native.
* text=auto

# The engine is a build artifact whose exact bytes are recorded in
# engine/PROVENANCE.json and checked by tests/run_engine_test.js. Line-ending
# normalisation would rewrite the glue and break that hash on checkout, so keep
# git away from both files entirely.
engine/dsat_*.js -text
engine/dsat_*.wasm binary
